<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 4: Local API Server. INTERNET is required for any socket bind
         even loopback-only (Android enforces this regardless of address);
         the actual LAN exposure is protected by mandatory API-key authentication in code
         (LocalApiServer binds "0.0.0.0" intentionally for paired devices) and
         in network_security_config.xml. FOREGROUND_SERVICE(+DATA_SYNC) lets
         the server keep running while the app is backgrounded, matching the
         mockup's "Works in Background" highlight badge. POST_NOTIFICATIONS
         is needed on Android 13+ to show the ongoing-server notification
         (the service still runs fine without it granted, it just won't be
         visible in the status bar). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phase 22: real, user-supplied Tavily web-search provider.
         ACCESS_NETWORK_STATE is the real permission
         ConnectivityChecker.hasInternet() needs to genuinely read the
         device's current network capabilities before ever attempting a
         real outbound call to api.tavily.com - INTERNET above already
         covers the outbound HTTPS call itself (same permission Phase 4's
         Local API server already declared). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Compute Bridge - required for reliable NSD (_sa-compute._tcp)
         discovery of Worker phones on the local Wi-Fi/hotspot network on
         several OEM builds (same permission the Worker app itself already
         declares for its own advertiser). No new capability beyond
         discovering/talking to a paired worker over the existing INTERNET
         permission above. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />



    <!-- Phase 11: Artifact card + ZIP/file output + download flow. Only
         needed for the real legacy (API 26-28) "Save to Device" path in
         ArtifactFileManager.exportToDownloads - API 29+ uses scoped-storage
         MediaStore.Downloads instead, which needs no permission at all
         (maxSdkVersion=28 reflects that honestly, same targeted-permission
         approach the Phase 4 permissions above already use). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Chat Bot fix bundle: lets the app show the real system "Ignore
         battery optimizations" dialog (Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS)
         instead of only linking the user to the general battery settings
         list. Without this exemption, Android's Doze/App Standby can pause
         or kill this process in the background even while its foreground
         service is running - this is the single most common real-world
         cause of a backgrounded app "disappearing" on stock Android and
         especially on OEM skins (MIUI/ColorOS/FuntouchOS/OneUI) that add
         their own, stricter battery managers on top. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Compute Bridge QR camera scan: the in-app scanner (CameraX +
         on-device ML Kit) needs the real CAMERA permission, requested at
         runtime from QrScannerScreen (not just declared here). android:required="false"
         on the feature so devices/builds without a camera still install and
         run the app fine - pairing still works via the paste-code field on
         those. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <application
        android:name=".BrainApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.BrainOfflineAI"
        android:networkSecurityConfig="@xml/network_security_config"
        android:largeHeap="true"
        tools:targetApi="31"
        xmlns:tools="http://schemas.android.com/tools">
        <!-- largeHeap: a real GGUF model (even 1.5B Q4_K_M) plus its KV
             cache genuinely needs more Dalvik heap headroom than the
             default limit on many devices - this is a real requirement
             of Phase 2, not a precaution for something imaginary. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BrainOfflineAI"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 4: real foreground service hosting the loopback-only
             OpenAI-compatible server (see server/LocalApiServer.kt). Not
             exported - only this app can start/stop it. -->
        <service
            android:name=".server.LocalApiForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Chat Bot fix bundle: keeps app at foreground priority while a
             user-started generation is running (see tasks/ChatTaskForegroundService.kt).
             Uses the same dataSync type + permissions already declared above. -->
        <service
            android:name=".tasks.ChatTaskForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Phase 11: real FileProvider so Share / Open in File Manager can
             hand a genuine content:// Uri to another app for an artifact
             file that actually lives in this app's private storage - never
             exported, never grants broader access than the one file's Uri
             it's asked for (see ArtifactFileManager.getShareUri). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
